// Behaviors: `Name(Type) = impl;` binds compile-time knowledge to a type.
// Ord(T) names compare, least and greatest; sort uses compare, and
// Reverse(...) flips the order.
// Show(T) = (T) -> Str is used by f-string holes (also inside lists).
// Other orders: a comparator closure and a small merge sort.
type Employee = { Str name; Int age; Int salary; };

Int by_age(Employee a, Employee b) { return a.age - b.age; }
Employee younger(Employee a, Employee b) { return if (a.age <= b.age) { a } else { b }; }
Employee older(Employee a, Employee b) { return if (a.age >= b.age) { a } else { b }; }
Ord(Employee) = { .compare = by_age, .least = younger, .greatest = older };

Str show_emp(Employee e) { return f"{e.name}/{e.age}/{e.salary}"; }
Show(Employee) = show_emp;

// Str has no `<`; compare code points (sort(List(Str)) is built in).
Int str_cmp(Str a, Str b, Int i) {
    Int la = str_len(a);
    Int lb = str_len(b);
    if (i >= la || i >= lb) { return la - lb; }
    Int d = str_char_at(a, i) - str_char_at(b, i);
    if (d != 0) { return d; }
    return str_cmp(a, b, i + 1);
}

// Stable merge sort by any comparator.
List(Employee) merge(List(Employee) a, List(Employee) b, Int closure(Employee, Employee) cmp, Int i, Int j, ListBuf(Employee) out) {
    if (i >= a.len() && j >= b.len()) { return out.finish(); }
    if (j >= b.len()) { return merge(a, b, cmp, i + 1, j, out.push(a[i])); }
    if (i >= a.len()) { return merge(a, b, cmp, i, j + 1, out.push(b[j])); }
    if (cmp(b[j], a[i]) < 0) { return merge(a, b, cmp, i, j + 1, out.push(b[j])); }
    return merge(a, b, cmp, i + 1, j, out.push(a[i]));
}

List(Employee) sort_by(List(Employee) xs, Int closure(Employee, Employee) cmp) {
    if (xs.len() <= 1) { return xs; }
    Int mid = xs.len() / 2;
    return merge(sort_by(xs[0..mid], cmp), sort_by(xs[mid..], cmp), cmp, 0, 0, ListBuf());
}

Int main() {
    List(Employee) staff = [
        Employee {.name = "mara", .age = 41, .salary = 5200},
        Employee {.name = "ben", .age = 29, .salary = 6100},
        Employee {.name = "ines", .age = 35, .salary = 4800}
    ];
    println(f"by age:       {sort(staff)}");                       // unique Ord inserted
    println(f"oldest first: {sort(staff, using = Reverse(Ord(Employee)))}");
    println(f"by salary:    {sort_by(staff, lambda(a, b) { a.salary - b.salary })}");
    println(f"by name:      {sort_by(staff, lambda(a, b) { str_cmp(a.name, b.name, 0) })}");
    List(Int) nums = [5, 2, 9];
    println(f"{sort(nums)} {sort(nums, using = Reverse(Ord(Int)))}");
    return 0;
}
