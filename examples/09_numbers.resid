// Numeric families: every width is its own type; no implicit narrowing;
// arithmetic is checked (overflow aborts); widen before multiplying when
// the product needs headroom; wrapping_*/saturating_* when you want it.
Int main() {
    Int(8) small = 100;
    Int(16) wide = (Int(16))small * small;      // widen first: 10000
    println(f"{wide}");

    UInt(8) a = 250;
    UInt(8) b = 10;
    println(f"{wrapping_uadd(a, b)} {saturating_uadd(a, b)}");  // 4 255

    Int x = 300;
    UInt(8) low = wrapping_u8(x);    // keep low bits: 44
    UInt(8) exact = u8(200);         // checked conversion
    println(f"{low} {exact}");

    Int(128) big = (Int(128))10000000000 * 10000000000;
    println(f"{big}");

    Float avg = (Float)7 / 2.0;
    Int trunc = 7 / 2;
    Int neg = -7 / 2;
    Int rem = -7 % 3;
    println(f"{avg} {trunc} {neg} {rem}");

    // Dec: exact decimal money. Dec(N) = N significant digits.
    Dec(10) price = 19.99m;
    Dec(10) qty = d10(3);
    Dec(10) total = price * qty;
    println(f"{total} {total:.}");
    println(f"{abs(-5)} {min(3, 9)} {max(2.5, 1.5)} {clamp(15, 0, 10)}");
    return 0;
}
